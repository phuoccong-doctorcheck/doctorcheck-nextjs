# ==============================================================================
# DoctorCheck Next.js CMS — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: Never commit active credentials, private keys, or passwords to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & SERVER
# ------------------------------------------------------------------------------
# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Session Security Secret (Recommended for production)
# Generate via: openssl rand -base64 32
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# Standard format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctorcheck_dev?schema=public

# ------------------------------------------------------------------------------
# 3. MEDIA STORAGE CONFIGURATION (CMS-3 / CMS-12)
# ------------------------------------------------------------------------------
# Storage Provider: 'local' (development) | 's3' (production object storage)
STORAGE_PROVIDER=local

# Set to 'true' ONLY if running production on a VM with persistent local disk storage.
# If omitted or 'false' in production, STORAGE_PROVIDER=s3 is required to prevent ephemeral media loss.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# S3 / Cloudflare R2 / MinIO / Wasabi Object Storage Configuration
# Required when STORAGE_PROVIDER=s3
S3_BUCKET=doctorcheck-media
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=https://media.doctorcheck.vn

# ------------------------------------------------------------------------------
# 4. DOMAIN DATA PROVIDER OVERRIDES (DB-6 through DB-12)
# ------------------------------------------------------------------------------
# Global Fallback Provider: 'postgres' (recommended) | 'static'
DATA_PROVIDER=postgres

# Domain-Level Providers (All cut over to 'postgres')
DOCTOR_DATA_PROVIDER=postgres
PACKAGE_DATA_PROVIDER=postgres
CATEGORY_DATA_PROVIDER=postgres
ARTICLE_DATA_PROVIDER=postgres
PAGE_DATA_PROVIDER=postgres
CLINIC_DATA_PROVIDER=postgres
CLINICAL_TRUST_DATA_PROVIDER=postgres
HOMEPAGE_DATA_PROVIDER=postgres

# ------------------------------------------------------------------------------
# 5. INITIAL BOOTSTRAP (CLI scripts only - not read during normal runtime)
# ------------------------------------------------------------------------------
# Used only by scripts/bootstrap-superadmin.ts for initial provisioning
# BOOTSTRAP_ADMIN_EMAIL=admin@doctorcheck.vn
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME="DoctorCheck Super Administrator"
